<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/idClMyMedicines"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    >

    <ScrollView
        android:id="@+id/idSvMyMedicines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@id/idNavDivider"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Cabeçalho de perfil -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/idIvUserPicture"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/perfil"
                    android:contentDescription="Foto do usuário"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/idTvWelcomeMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/welcome_message"
                        android:textColor="@color/grey_1" />

                    <TextView
                        android:id="@+id/idTvUserName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user_name"
                        android:textColor="@color/black"
                        android:textSize="18sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <!-- Data atual -->
            <TextView
                android:id="@+id/idTvCurrentDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/current_date"
                android:textColor="@color/grey_2" />

            <!-- Título "Meus Remédios" com ícone -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/idIvMyMedicinesIcon"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_pill"
                    app:tint="@color/primary" />

                <TextView
                    android:id="@+id/idTvMyMedicinesTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meus Remédios"
                    android:textColor="@color/black"
                    android:textSize="24sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Botão Adicionar Remédio -->
            <Button
                android:id="@+id/idBtnAddMedicine"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="16dp"
                android:text="Adicionar remédio"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_add"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white" />


            <!-- Card de Medicamento -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/idCardMedication"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                android:checkable="true"
                app:cardCornerRadius="6dp"
                app:checkedIconEnabled="false"
                app:strokeColor="@color/grey_3"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <!-- Informações do Remédio -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/idTvMedicineTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vitamina D"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/idTvMedicineDosage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2 gotas"
                            android:textColor="@color/grey_1"
                            android:textSize="12sp" />
                        <Button
                            android:id="@+id/idBtnTakeMedicine"
                            android:layout_width="wrap_content"
                            android:layout_height="38dp"
                            android:paddingHorizontal="16dp"
                            android:radius="50dp"
                            android:text="8:00"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            app:backgroundTint="@color/primary"
                            app:icon="@drawable/ic_clock"/>
                    </LinearLayout>
                    <!-- Botão de Excluir -->
                    <ImageButton
                        android:id="@+id/idIbDeleteMedicine"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/bg_circle_primary"
                        android:contentDescription="Excluir remédio"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_trash"
                        app:tint="@color/white" />


                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>

    </ScrollView>

    <!-- Adiciona o container da barra-->

    <View android:background="#EEEEEE" android:id="@+id/idNavDivider" android:layout_height="1dp" android:layout_width="match_parent" app:layout_constraintBottom_toTopOf="@id/idCustomBottomNav"/>

    <LinearLayout android:background="@color/white" android:baselineAligned="false" android:id="@+id/idCustomBottomNav" android:layout_height="64dp" android:layout_width="match_parent" android:orientation="horizontal" app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>